package(default_visibility = ["//visibility:public"])

java_library(
    name = "core_lib",
    srcs = [
        "src/main/java/io/github/manuzhang/iceberg/examples/DataOperationsExample.java",
        "src/main/java/io/github/manuzhang/iceberg/examples/IcebergExamples.java",
        "src/main/java/io/github/manuzhang/iceberg/examples/RowLevelUpsertExample.java",
        "src/main/java/io/github/manuzhang/iceberg/examples/SchemaEvolutionExample.java",
        "src/main/java/io/github/manuzhang/iceberg/examples/SharedInMemoryFileIO.java",
        "src/main/java/io/github/manuzhang/iceberg/examples/TableFormatV3Example.java",
        "src/main/java/org/apache/iceberg/rest/EmbeddedRestCatalogServer.java",
    ],
    deps = [
        "@maven//:org_apache_iceberg_iceberg_api",
        "@maven//:org_apache_iceberg_iceberg_core",
        "@maven//:org_apache_iceberg_iceberg_data",
        "@maven//:org_apache_iceberg_iceberg_open_api",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_slf4j_slf4j_simple",
        "@maven//:org_xerial_sqlite_jdbc",
    ],
)

java_library(
    name = "beam_lib",
    srcs = [
        "src/main/java/io/github/manuzhang/iceberg/examples/BeamIcebergCdcExample.java",
        "src/main/java/io/github/manuzhang/iceberg/examples/BeamIcebergExample.java",
    ],
    deps = [
        ":core_lib",
        "@maven//:org_apache_beam_beam_runners_direct_java",
        "@maven//:org_apache_beam_beam_sdks_java_core",
        "@maven//:org_apache_beam_beam_sdks_java_io_iceberg",
        "@maven//:org_apache_beam_beam_sdks_java_managed",
        "@maven//:org_apache_iceberg_iceberg_api",
        "@maven//:org_apache_iceberg_iceberg_core",
        "@maven//:org_apache_iceberg_iceberg_open_api",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:org_slf4j_slf4j_simple",
        "@maven//:org_xerial_sqlite_jdbc",
        "@maven//:org_yaml_snakeyaml",
    ],
)

java_library(
    name = "lib",
    deps = [
        ":beam_lib",
        ":core_lib",
    ],
)

java_binary(
    name = "iceberg_examples",
    main_class = "io.github.manuzhang.iceberg.examples.IcebergExamples",
    runtime_deps = [":core_lib"],
)

java_binary(
    name = "data_operations_example",
    main_class = "io.github.manuzhang.iceberg.examples.DataOperationsExample",
    runtime_deps = [":core_lib"],
)

java_binary(
    name = "schema_evolution_example",
    main_class = "io.github.manuzhang.iceberg.examples.SchemaEvolutionExample",
    runtime_deps = [":core_lib"],
)

java_binary(
    name = "table_format_v3_example",
    main_class = "io.github.manuzhang.iceberg.examples.TableFormatV3Example",
    runtime_deps = [":core_lib"],
)

java_binary(
    name = "row_level_upsert_example",
    main_class = "io.github.manuzhang.iceberg.examples.RowLevelUpsertExample",
    runtime_deps = [":core_lib"],
)

java_binary(
    name = "beam_iceberg_example",
    main_class = "io.github.manuzhang.iceberg.examples.BeamIcebergExample",
    runtime_deps = [
        # Keep Iceberg open-api before Hadoop's Jetty 9 transitive jars for RESTCatalogServer.
        "@maven//:org_apache_iceberg_iceberg_open_api",
        ":beam_lib",
    ],
)

java_binary(
    name = "beam_iceberg_cdc_example",
    main_class = "io.github.manuzhang.iceberg.examples.BeamIcebergCdcExample",
    runtime_deps = [
        # Keep Iceberg open-api before Hadoop's Jetty 9 transitive jars for RESTCatalogServer.
        "@maven//:org_apache_iceberg_iceberg_open_api",
        ":beam_lib",
    ],
)

java_test(
    name = "iceberg_examples_test",
    srcs = ["src/test/java/io/github/manuzhang/iceberg/examples/IcebergExamplesTest.java"],
    test_class = "io.github.manuzhang.iceberg.examples.IcebergExamplesTest",
    deps = [
        ":core_lib",
        "@maven//:junit_junit",
        "@maven//:org_apache_iceberg_iceberg_api",
    ],
)

java_test(
    name = "beam_iceberg_cdc_example_test",
    srcs = ["src/test/java/io/github/manuzhang/iceberg/examples/BeamIcebergCdcExampleTest.java"],
    test_class = "io.github.manuzhang.iceberg.examples.BeamIcebergCdcExampleTest",
    deps = [
        ":beam_lib",
        "@maven//:junit_junit",
        "@maven//:org_apache_beam_beam_runners_direct_java",
        "@maven//:org_apache_beam_beam_sdks_java_io_iceberg",
        "@maven//:org_apache_iceberg_iceberg_api",
    ],
)

java_test(
    name = "beam_iceberg_example_test",
    srcs = ["src/test/java/io/github/manuzhang/iceberg/examples/BeamIcebergExampleTest.java"],
    test_class = "io.github.manuzhang.iceberg.examples.BeamIcebergExampleTest",
    deps = [
        ":beam_lib",
        "@maven//:junit_junit",
        "@maven//:org_apache_beam_beam_runners_direct_java",
        "@maven//:org_apache_beam_beam_sdks_java_io_iceberg",
        "@maven//:org_apache_iceberg_iceberg_api",
    ],
)

java_test(
    name = "row_level_upsert_example_test",
    srcs = ["src/test/java/io/github/manuzhang/iceberg/examples/RowLevelUpsertExampleTest.java"],
    test_class = "io.github.manuzhang.iceberg.examples.RowLevelUpsertExampleTest",
    deps = [
        ":core_lib",
        "@maven//:junit_junit",
        "@maven//:org_apache_iceberg_iceberg_api",
        "@maven//:org_apache_iceberg_iceberg_core",
        "@maven//:org_apache_iceberg_iceberg_data",
    ],
