load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "go_default_library",
    srcs = [
        "main.go",
        "rest_catalog_example.go",
    ],
    importpath = "github.com/manuzhang/iceberg-examples/iceberg-go",
    deps = [
        "@com_github_apache_arrow_go_v18//arrow",
        "@com_github_apache_arrow_go_v18//arrow/array",
        "@com_github_apache_arrow_go_v18//arrow/memory",
        "@com_github_apache_iceberg_go//:iceberg-go",
        "@com_github_apache_iceberg_go//catalog",
        "@com_github_apache_iceberg_go//catalog/rest",
        "@com_github_apache_iceberg_go//table",
    ],
)

go_binary(
    name = "iceberg_go_example",
    embed = [":go_default_library"],
)

go_test(
    name = "iceberg_go_test",
    srcs = ["main_test.go"],
    embed = [":go_default_library"],
)
